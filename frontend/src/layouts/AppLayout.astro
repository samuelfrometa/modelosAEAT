---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { MOCK_USER } from '../data/mock';

interface Props { title: string; }
const { title } = Astro.props;
const path = Astro.url.pathname;
---
<!DOCTYPE html>
<html lang="es" data-variant="calido">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
<div class="app">
  <header class="appbar">
    <div class="appbar-inner">

      <a href="/dashboard" class="navlink" style="padding:0;background:none;text-decoration:none" id="btn-logo">
        <span class="logo" style="display:inline-flex;align-items:center;gap:9px">
          <span class="logo-mark" style="width:28px;height:28px;color:var(--accent)">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none">
              <rect x="3" y="3" width="18" height="18" rx="5" fill="currentColor" opacity="0.14" />
              <rect x="3.75" y="3.75" width="16.5" height="16.5" rx="4.25" stroke="currentColor" stroke-width="1.6" />
              <path d="M8 12.4l2.6 2.6L16 9.2" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <span class="logo-word">Casilla</span>
        </span>
      </a>

      <nav class="appbar-nav">
        <a href="/dashboard" class={`navlink${path === '/dashboard' ? ' active' : ''}`}>
          <Icon name="grid" size={16} />Panel
        </a>
        <a href="/nuevo" class={`navlink${path === '/nuevo' ? ' active' : ''}`}>
          <Icon name="upload" size={16} />Subir
        </a>
        <button class="navlink" id="nav-modelos">
          <Icon name="fileText" size={16} />Modelos
        </button>
      </nav>

      <div class="appbar-spacer"></div>

      <button class="navlink" id="btn-logout" title="Cerrar sesión">
        <Icon name="logOut" size={16} />
      </button>

      <button class="avatar" id="btn-avatar">{MOCK_USER.initials}</button>

    </div>
  </header>

  <main class="main">
    <slot />
  </main>

  <div id="toast-root"></div>
</div>

<script>
  import { showToast } from '../scripts/toast';

  document.getElementById('nav-modelos')?.addEventListener('click', () => showToast('Nav: Modelos'));
  document.getElementById('btn-avatar')?.addEventListener('click', () => showToast('Perfil'));

  document.getElementById('btn-logout')?.addEventListener('click', () => {
    localStorage.removeItem('access');
    localStorage.removeItem('refresh');
    window.location.href = '/login';
  });
</script>
</body>
</html>
