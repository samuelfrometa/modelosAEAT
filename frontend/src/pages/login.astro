---
import '../styles/global.css';
const title = "Iniciar sesión";
---

<html lang="es" data-variant="calido">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <style>
      body {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
      }

      .auth-card {
        background: var(--surface);
        border: var(--border-w) solid var(--line);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-lg);
        padding: 2.5rem 2rem;
        width: 100%;
        max-width: 400px;
      }

      .auth-card h1 {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--ink);
        letter-spacing: -.025em;
        margin-bottom: 0.25rem;
      }

      .auth-sub {
        font-size: 0.875rem;
        color: var(--ink-2);
        margin-bottom: 1.75rem;
      }

      .form-field {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
        margin-bottom: 1rem;
      }

      .form-field label {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--ink);
      }

      .input input { width: 100%; }

      .submit-btn {
        width: 100%;
        margin-top: 0.5rem;
        justify-content: center;
      }

      .footer-link {
        text-align: center;
        margin-top: 1.25rem;
        font-size: 0.875rem;
        color: var(--ink-2);
      }

      .footer-link a {
        color: var(--accent-strong);
        text-decoration: none;
        font-weight: 600;
      }

      .footer-link a:hover { text-decoration: underline; }

      .error-box {
        display: none;
        background: var(--danger-soft);
        border: var(--border-w) solid color-mix(in srgb, var(--danger) 30%, transparent);
        color: var(--danger);
        border-radius: var(--radius-sm);
        padding: 0.625rem 0.75rem;
        font-size: 0.875rem;
        margin-bottom: 1rem;
      }

      .error-box.visible { display: block; }
    </style>
  </head>
  <body>
    <div class="auth-card">
      <h1>Bienvenido</h1>
      <p class="auth-sub">Introduce tus credenciales para acceder</p>

      <div id="error" class="error-box" role="alert"></div>

      <form id="login-form" novalidate>
        <div class="form-field">
          <label for="email">Correo electrónico</label>
          <div class="input">
            <input
              id="email"
              type="email"
              name="email"
              autocomplete="email"
              placeholder="usuario@ejemplo.com"
              required
            />
          </div>
        </div>

        <div class="form-field">
          <label for="password">Contraseña</label>
          <div class="input">
            <input
              id="password"
              type="password"
              name="password"
              autocomplete="current-password"
              placeholder="••••••••"
              required
            />
          </div>
        </div>

        <button type="submit" id="submit-btn" class="btn btn-primary btn-md submit-btn">Iniciar sesión</button>
      </form>

      <p class="footer-link">¿No tienes cuenta? <a href="/register">Regístrate</a></p>
    </div>

    <script>
      const form = document.getElementById("login-form") as HTMLFormElement;
      const errorBox = document.getElementById("error") as HTMLDivElement;
      const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        errorBox.classList.remove("visible");
        submitBtn.disabled = true;
        submitBtn.textContent = "Entrando…";

        const email = (document.getElementById("email") as HTMLInputElement).value.trim();
        const password = (document.getElementById("password") as HTMLInputElement).value;

        try {
          const API = import.meta.env.PUBLIC_API_URL;
          const res = await fetch(`${API}/v1/auth/login/`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email, password }),
          });

          if (res.ok) {
            const data = await res.json();
            localStorage.setItem("access", data.access);
            localStorage.setItem("refresh", data.refresh);
            window.location.href = "/";
          } else {
            const data = await res.json().catch(() => ({}));
            const msg =
              data.detail ||
              data.non_field_errors?.[0] ||
              "Credenciales incorrectas. Inténtalo de nuevo.";
            showError(msg);
          }
        } catch {
          showError("No se pudo conectar con el servidor. Comprueba tu conexión.");
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = "Iniciar sesión";
        }
      });

      function showError(msg: string) {
        errorBox.textContent = msg;
        errorBox.classList.add("visible");
      }
    </script>
  </body>
</html>
