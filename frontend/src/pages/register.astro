---
const title = "Crear cuenta";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        font-family: system-ui, -apple-system, sans-serif;
        background: #f1f5f9;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
        padding: 2.5rem 2rem;
        width: 100%;
        max-width: 420px;
      }

      .card h1 {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 0.25rem;
      }

      .card p {
        font-size: 0.875rem;
        color: #64748b;
        margin-bottom: 1.75rem;
      }

      .row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
      }

      .field {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
        margin-bottom: 1rem;
      }

      label {
        font-size: 0.875rem;
        font-weight: 500;
        color: #374151;
      }

      input {
        padding: 0.625rem 0.75rem;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        font-size: 0.9375rem;
        color: #1e293b;
        outline: none;
        transition: border-color 0.15s;
      }

      input:focus {
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59,130,246,0.15);
      }

      input.invalid {
        border-color: #f87171;
      }

      .field-error {
        font-size: 0.75rem;
        color: #b91c1c;
        display: none;
      }

      .field-error.visible { display: block; }

      button[type="submit"] {
        width: 100%;
        padding: 0.6875rem;
        margin-top: 0.5rem;
        background: #2563eb;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 0.9375rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.15s;
      }

      button[type="submit"]:hover { background: #1d4ed8; }
      button[type="submit"]:disabled { background: #93c5fd; cursor: not-allowed; }

      .alert {
        display: none;
        border-radius: 8px;
        padding: 0.625rem 0.75rem;
        font-size: 0.875rem;
        margin-bottom: 1rem;
      }

      .alert.error {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #b91c1c;
      }

      .alert.success {
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        color: #15803d;
      }

      .alert.visible { display: block; }

      .footer-link {
        text-align: center;
        margin-top: 1.25rem;
        font-size: 0.875rem;
        color: #64748b;
      }

      .footer-link a {
        color: #2563eb;
        text-decoration: none;
        font-weight: 500;
      }

      .footer-link a:hover { text-decoration: underline; }
    </style>
  </head>
  <body>
    <div class="card">
      <h1>Crear cuenta</h1>
      <p>Rellena el formulario para registrarte</p>

      <div id="alert" class="alert" role="alert"></div>

      <form id="register-form" novalidate>
        <div class="row">
          <div class="field">
            <label for="first_name">Nombre <span aria-hidden="true">*</span></label>
            <input id="first_name" type="text" name="first_name" autocomplete="given-name" placeholder="Ana" required />
            <span class="field-error" id="err-first_name"></span>
          </div>
          <div class="field">
            <label for="last_name">Apellidos</label>
            <input id="last_name" type="text" name="last_name" autocomplete="family-name" placeholder="García" />
          </div>
        </div>

        <div class="field">
          <label for="email">Correo electrónico <span aria-hidden="true">*</span></label>
          <input id="email" type="email" name="email" autocomplete="email" placeholder="ana@ejemplo.com" required />
          <span class="field-error" id="err-email"></span>
        </div>

        <div class="field">
          <label for="password">Contraseña <span aria-hidden="true">*</span></label>
          <input id="password" type="password" name="password" autocomplete="new-password" placeholder="Mínimo 8 caracteres" required />
          <span class="field-error" id="err-password"></span>
        </div>

        <div class="field">
          <label for="password_confirm">Confirmar contraseña <span aria-hidden="true">*</span></label>
          <input id="password_confirm" type="password" name="password_confirm" autocomplete="new-password" placeholder="Repite la contraseña" required />
          <span class="field-error" id="err-password_confirm"></span>
        </div>

        <button type="submit" id="submit-btn">Crear cuenta</button>
      </form>

      <p class="footer-link">¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>
    </div>

    <script>
      const form = document.getElementById("register-form") as HTMLFormElement;
      const alertBox = document.getElementById("alert") as HTMLDivElement;
      const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;

      const fields = ["first_name", "last_name", "email", "password", "password_confirm"];

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        clearErrors();
        submitBtn.disabled = true;
        submitBtn.textContent = "Creando cuenta…";

        const body: Record<string, string> = {};
        for (const name of fields) {
          const el = document.getElementById(name) as HTMLInputElement;
          body[name] = el.value.trim();
        }
        // password fields shouldn't be trimmed
        body["password"] = (document.getElementById("password") as HTMLInputElement).value;
        body["password_confirm"] = (document.getElementById("password_confirm") as HTMLInputElement).value;

        try {
          const res = await fetch("/v1/auth/register/", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(body),
          });

          if (res.status === 201) {
            showAlert("success", "Cuenta creada correctamente. Redirigiendo al login…");
            form.reset();
            setTimeout(() => { window.location.href = "/login"; }, 1500);
          } else {
            const data = await res.json().catch(() => ({}));
            if (typeof data === "object" && !data.detail) {
              // field-level errors
              let hasFieldError = false;
              for (const [field, msgs] of Object.entries(data)) {
                const errEl = document.getElementById(`err-${field}`);
                const inputEl = document.getElementById(field) as HTMLInputElement | null;
                const msg = Array.isArray(msgs) ? (msgs as string[]).join(" ") : String(msgs);
                if (errEl) {
                  errEl.textContent = msg;
                  errEl.classList.add("visible");
                  inputEl?.classList.add("invalid");
                  hasFieldError = true;
                }
              }
              if (!hasFieldError) {
                showAlert("error", "Error al crear la cuenta. Revisa los datos.");
              }
            } else {
              showAlert("error", data.detail || "Error al crear la cuenta.");
            }
          }
        } catch {
          showAlert("error", "No se pudo conectar con el servidor.");
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = "Crear cuenta";
        }
      });

      function clearErrors() {
        alertBox.className = "alert";
        alertBox.textContent = "";
        for (const name of fields) {
          const errEl = document.getElementById(`err-${name}`);
          const inputEl = document.getElementById(name) as HTMLInputElement | null;
          errEl?.classList.remove("visible");
          inputEl?.classList.remove("invalid");
        }
      }

      function showAlert(type: "success" | "error", msg: string) {
        alertBox.textContent = msg;
        alertBox.className = `alert ${type} visible`;
      }
    </script>
  </body>
</html>
