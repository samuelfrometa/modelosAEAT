---
import '../styles/global.css';
const title = "Crear cuenta";
---

<html lang="es" data-variant="calido">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <style>
      body {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
      }

      .auth-card {
        background: var(--surface);
        border: var(--border-w) solid var(--line);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-lg);
        padding: 2.5rem 2rem;
        width: 100%;
        max-width: 440px;
      }

      .auth-card h1 {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--ink);
        letter-spacing: -.025em;
        margin-bottom: 0.25rem;
      }

      .auth-sub {
        font-size: 0.875rem;
        color: var(--ink-2);
        margin-bottom: 1.75rem;
      }

      .name-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
      }

      .form-field {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
        margin-bottom: 1rem;
      }

      .form-field label {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--ink);
      }

      .input input { width: 100%; }

      .input input.invalid {
        border-color: var(--danger);
        background: var(--danger-soft);
      }

      .field-error {
        font-size: 0.75rem;
        color: var(--danger);
        display: none;
      }

      .field-error.visible { display: block; }

      .submit-btn {
        width: 100%;
        margin-top: 0.5rem;
        justify-content: center;
      }

      .alert {
        display: none;
        border-radius: var(--radius-sm);
        padding: 0.625rem 0.75rem;
        font-size: 0.875rem;
        margin-bottom: 1rem;
      }

      .alert.error {
        background: var(--danger-soft);
        border: var(--border-w) solid color-mix(in srgb, var(--danger) 30%, transparent);
        color: var(--danger);
      }

      .alert.success {
        background: var(--ok-soft);
        border: var(--border-w) solid color-mix(in srgb, var(--ok) 30%, transparent);
        color: var(--ok);
      }

      .alert.visible { display: block; }

      .footer-link {
        text-align: center;
        margin-top: 1.25rem;
        font-size: 0.875rem;
        color: var(--ink-2);
      }

      .footer-link a {
        color: var(--accent-strong);
        text-decoration: none;
        font-weight: 600;
      }

      .footer-link a:hover { text-decoration: underline; }
    </style>
  </head>
  <body>
    <div class="auth-card">
      <h1>Crear cuenta</h1>
      <p class="auth-sub">Rellena el formulario para registrarte</p>

      <div id="alert" class="alert" role="alert"></div>

      <form id="register-form" novalidate>
        <div class="name-row">
          <div class="form-field">
            <label for="first_name">Nombre <span aria-hidden="true">*</span></label>
            <div class="input">
              <input id="first_name" type="text" name="first_name" autocomplete="given-name" placeholder="Ana" required />
            </div>
            <span class="field-error" id="err-first_name"></span>
          </div>
          <div class="form-field">
            <label for="last_name">Apellidos</label>
            <div class="input">
              <input id="last_name" type="text" name="last_name" autocomplete="family-name" placeholder="García" />
            </div>
          </div>
        </div>

        <div class="form-field">
          <label for="email">Correo electrónico <span aria-hidden="true">*</span></label>
          <div class="input">
            <input id="email" type="email" name="email" autocomplete="email" placeholder="ana@ejemplo.com" required />
          </div>
          <span class="field-error" id="err-email"></span>
        </div>

        <div class="form-field">
          <label for="password">Contraseña <span aria-hidden="true">*</span></label>
          <div class="input">
            <input id="password" type="password" name="password" autocomplete="new-password" placeholder="Mínimo 8 caracteres" required />
          </div>
          <span class="field-error" id="err-password"></span>
        </div>

        <div class="form-field">
          <label for="password_confirm">Confirmar contraseña <span aria-hidden="true">*</span></label>
          <div class="input">
            <input id="password_confirm" type="password" name="password_confirm" autocomplete="new-password" placeholder="Repite la contraseña" required />
          </div>
          <span class="field-error" id="err-password_confirm"></span>
        </div>

        <button type="submit" id="submit-btn" class="btn btn-primary btn-md submit-btn">Crear cuenta</button>
      </form>

      <p class="footer-link">¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>
    </div>

    <script>
      const form = document.getElementById("register-form") as HTMLFormElement;
      const alertBox = document.getElementById("alert") as HTMLDivElement;
      const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;

      const fields = ["first_name", "last_name", "email", "password", "password_confirm"];

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        clearErrors();
        submitBtn.disabled = true;
        submitBtn.textContent = "Creando cuenta…";

        const body: Record<string, string> = {};
        for (const name of fields) {
          const el = document.getElementById(name) as HTMLInputElement;
          body[name] = el.value.trim();
        }
        body["password"] = (document.getElementById("password") as HTMLInputElement).value;
        body["password_confirm"] = (document.getElementById("password_confirm") as HTMLInputElement).value;

        try {
          const API = import.meta.env.PUBLIC_API_URL;
          const res = await fetch(`${API}/v1/auth/register/`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(body),
          });

          if (res.status === 201) {
            showAlert("success", "Cuenta creada correctamente. Redirigiendo al login…");
            form.reset();
            setTimeout(() => { window.location.href = "/login"; }, 1500);
          } else {
            const data = await res.json().catch(() => ({}));
            if (typeof data === "object" && !data.detail) {
              let hasFieldError = false;
              for (const [field, msgs] of Object.entries(data)) {
                const errEl = document.getElementById(`err-${field}`);
                const inputEl = document.getElementById(field) as HTMLInputElement | null;
                const msg = Array.isArray(msgs) ? (msgs as string[]).join(" ") : String(msgs);
                if (errEl) {
                  errEl.textContent = msg;
                  errEl.classList.add("visible");
                  inputEl?.classList.add("invalid");
                  hasFieldError = true;
                }
              }
              if (!hasFieldError) {
                showAlert("error", "Error al crear la cuenta. Revisa los datos.");
              }
            } else {
              showAlert("error", data.detail || "Error al crear la cuenta.");
            }
          }
        } catch {
          showAlert("error", "No se pudo conectar con el servidor.");
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = "Crear cuenta";
        }
      });

      function clearErrors() {
        alertBox.className = "alert";
        alertBox.textContent = "";
        for (const name of fields) {
          const errEl = document.getElementById(`err-${name}`);
          const inputEl = document.getElementById(name) as HTMLInputElement | null;
          errEl?.classList.remove("visible");
          inputEl?.classList.remove("invalid");
        }
      }

      function showAlert(type: "success" | "error", msg: string) {
        alertBox.textContent = msg;
        alertBox.className = `alert ${type} visible`;
      }
    </script>
  </body>
</html>
